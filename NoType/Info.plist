<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>NoType</string>
	<key>CFBundleDisplayName</key>
	<string>NoType</string>
	<key>CFBundleIdentifier</key>
	<string>app.notype</string>
	<key>CFBundleVersion</key>
	<string>16</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.13-rc1</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>LSUIElement</key>
	<true/>
	<!--
	NSSupportsAutomaticTermination=false: as an LSUIElement app the
	system would otherwise consider us idle whenever no windows are
	visible — including while the menu-bar tray icon is the only UI —
	and AppKit would silently terminate the process. That kills the
	hotkey monitor, recording session, and history store in flight.
	Opt out so the app stays alive until the user quits.
	-->
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
	<key>NSMicrophoneUsageDescription</key>
	<string>NoType uses the microphone to record your voice for dictation.</string>
	<key>NSAccessibilityUsageDescription</key>
	<string>NoType reads on-screen text to improve transcription accuracy.</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>NoType reads on-screen text via screenshots to improve dictation accuracy in apps that don't expose their content via the accessibility API. Screen capture is optional — leave it off to use accessibility-only context.</string>
	<!--
	Sparkle 2 auto-update keys.
	  SUFeedURL          — appcast.xml served by GitHub Pages from /docs of this repo.
	  SUPublicEDKey      — EdDSA public key. Sparkle verifies every downloaded .zip
	                       against this. PRIVATE counterpart lives in GitHub Secrets
	                       as SPARKLE_ED_PRIVATE_KEY and is used by sign_update in CI.
	  SUEnableAutomaticChecks  — Sparkle polls the feed once a day on its own.
	  SUScheduledCheckInterval — 86400 = 24h.
	NoType is non-sandboxed (ADR-012) so Sparkle 2 installs directly without the
	XPC installer-launcher service; SUEnableInstallerLauncherService is not set.
	-->
	<key>SUFeedURL</key>
	<string>https://weylandd.github.io/NoType/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>cOX4eaRJU0LtvXuG/SpYgDUj1TQliI3L8mildkbQsi8=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
</dict>
</plist>
