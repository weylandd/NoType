<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- DO NOT add `keychain-access-groups` (or any other RESTRICTED
	     entitlement) here without also embedding a matching Developer ID
	     provisioning profile at Contents/embedded.provisionprofile.

	     macOS classes `keychain-access-groups` as restricted: AMFI refuses to
	     exec a binary carrying it unless the bundle embeds a profile that
	     grants it. The binary still passes `codesign --verify --deep --strict`,
	     notarization, stapling and `spctl --assess` — none of those validate
	     restricted entitlements — so the breakage is invisible until launch,
	     where the process is SIGKILLed before main() with
	     `amfid: -413 "No matching profile found"`. That shipped as v0.1.11 and
	     bricked every install.

	     scripts/release.sh now gates on this (see its "AMFI restricted-entitlement
	     gate" step). Re-enabling the data-protection keychain is tracked in
	     docs/solutions/documentation-gaps/developer-id-provisioning-profile-2026-07-25.md
	     and requires portal work, not just a code change.

	     See docs/solutions/runtime-errors/amfi-restricted-entitlement-launch-kill-2026-07-25.md. -->
</dict>
</plist>
