<?xml version="1.0" encoding="utf-8"?>
<!--
  NoType Sparkle appcast.

  Served by GitHub Pages from `docs/` of weylandd/NoType:
    https://weylandd.github.io/NoType/appcast.xml

  Items below are appended by `.github/workflows/release.yml` on every
  `v*` tag push. Newest first. Each item carries an EdDSA signature
  generated by Sparkle's `sign_update` against the release .zip — the
  app verifies it at install time against `SUPublicEDKey` in Info.plist.

  Manual edits are fine for emergencies (rollback a bad release by
  deleting its <item>), but the workflow is the normal path.
-->
<rss version="2.0"
     xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle"
     xmlns:dc="http://purl.org/dc/elements/1.1/">
  <channel>
    <title>NoType</title>
    <link>https://weylandd.github.io/NoType/appcast.xml</link>
    <description>NoType release feed for Sparkle 2 auto-updates.</description>
    <language>en</language>
  </channel>
</rss>
